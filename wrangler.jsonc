// Cloudflare Workers config: serve the static Vite build from ./dist.
// The name must match the project name in the Cloudflare dashboard.
{
  "name": "indie-cv",
  "compatibility_date": "2025-09-01",
  // Custom domains: wrangler creates the DNS records and certificates on deploy.
  "routes": [
    { "pattern": "pavelthewise.com", "custom_domain": true },
    { "pattern": "www.pavelthewise.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
